{
  "name": "me-event-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "corepack pnpm -r --if-present build",
    "db:migrate": "bash infrastructure/postgres/apply-migrations.sh",
    "db:seed:dev": "docker compose -f infrastructure/docker-compose.yml exec -T postgres psql -U me_event -d me_event_dev -v ON_ERROR_STOP=1 < infrastructure/postgres/seeds/dev-employee.sql",
    "db:status": "docker compose -f infrastructure/docker-compose.yml ps",
    "db:up": "docker compose -f infrastructure/docker-compose.yml up -d postgres redis",
    "dev:backend": "corepack pnpm --filter @me-event/backend dev",
    "dev:erp": "corepack pnpm --filter @me-event/erp-web dev",
    "dev:mobile": "cd apps/mobile && flutter run --flavor dev",
    "dev:mobile:android": "cd apps/mobile && flutter run -d android --flavor dev",
    "dev:mobile:ios": "cd apps/mobile && flutter run -d ios --flavor dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "corepack pnpm -r --if-present lint",
    "test": "corepack pnpm -r --if-present test",
    "test:e2e:guard": "bash scripts/e2e/loopback-guard.test.sh",
    "test:e2e:api": "E2E_API_BASE_URL=http://127.0.0.1:3002/api/v1 bash scripts/e2e/api-smoke.sh",
    "test:e2e:erp": "E2E_API_BASE_URL=http://127.0.0.1:3002/api/v1 E2E_ERP_BASE_URL=http://127.0.0.1:3001 E2E_EMPLOYEE_MOBILE=+919000000001 corepack pnpm --filter @me-event/erp-web test:e2e",
    "test:e2e:mobile": "E2E_API_BASE_URL=http://127.0.0.1:3002/api/v1 bash scripts/e2e/mobile-api-smoke.sh",
    "test:integration:backend": "corepack pnpm --filter @me-event/backend test:integration",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "verify": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build"
  },
  "devDependencies": {
    "prettier": "3.4.2"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "brace-expansion@5": "5.0.9",
      "fast-uri@3": "3.1.6",
      "js-yaml@4": "4.3.1",
      "nanoid@3": "3.3.18",
      "postcss@8": "8.5.26",
      "sharp": "0.35.3",
      "vite": "6.4.3"
    }
  }
}
