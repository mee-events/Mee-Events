# Mee Events Mobile — public runtime configuration only.
# Copy this file to ignored `.env` for local development.
# NEVER put backend HMAC/JWT secrets, refresh digests, or service-role keys here.
# `.env` is listed as a Flutter asset and can be bundled into the binary.
#
# Release/staging/production builds must pass a non-loopback API_BASE_URL with
# `--dart-define=API_BASE_URL=...`. Loopback and Android emulator hosts are
# rejected in release mode.
#
# CI also passes `--dart-define=APP_ENV=dev`. The app does not read APP_ENV;
# that define is unused until a later flavor-config task.

# Backend API base URL
API_BASE_URL=http://localhost:3002/api/v1

# Hyderabad branch code
BRANCH_CODE=HYD

# Legacy/dormant Supabase client initialization only. Public-class values.
# Removal is tracked in SEC-06. Do not add service-role keys.
SUPABASE_URL=your-project-url
SUPABASE_ANON_KEY=your-anon-key
