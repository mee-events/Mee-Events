# Mee Events Mobile — public runtime configuration only.
# Copy this file to ignored `.env` for local development.
# NEVER put backend HMAC/JWT secrets, refresh digests, or service-role keys here.
# `.env` is listed as a Flutter asset and can be bundled into the binary.
#
# Release/staging/production builds must pass a non-loopback HTTPS API_BASE_URL
# with `--dart-define=API_BASE_URL=...`. Loopback and Android emulator hosts are
# available only in debug/profile development.
#
# The app does not read an `APP_ENV` define. Build flavor/release mode and the
# explicit values below determine the current mobile configuration.

# Backend API base URL
API_BASE_URL=http://localhost:3002/api/v1

# Hyderabad branch code
BRANCH_CODE=HYD
