APP_ENV=development
PORT=3002
LOG_LEVEL=debug
DATABASE_URL=postgresql://me_event:local-development-only@localhost:5433/me_event_dev
OTP_PROVIDER=local
OTP_HMAC_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_HMAC_SECRET=replace-with-at-least-32-random-characters
# Comma-separated browser origins. In APP_ENV=development, any
# http://localhost:<port> / http://127.0.0.1:<port> origin is also allowed
# so Flutter Web (random port) can call the API.
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:8082
SUPABASE_URL=your-project-url
SUPABASE_SERVICE_KEY=your-service-role-key
