# Production placeholders. Inject real values from a secret manager.
# Copying these placeholder strings into a running process is rejected at boot.
APP_ENV=production
# Listen port is host-specific. Local development uses 3002.
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/me_event
OTP_PROVIDER=exotel
OTP_HMAC_SECRET=INJECT_FROM_SECRET_MANAGER
JWT_ACCESS_SECRET=INJECT_FROM_SECRET_MANAGER
REFRESH_TOKEN_HMAC_SECRET=INJECT_FROM_SECRET_MANAGER
EXOTEL_API_BASE_URL=https://api.in.exotel.com
EXOTEL_API_KEY=INJECT_FROM_SECRET_MANAGER
EXOTEL_API_TOKEN=INJECT_FROM_SECRET_MANAGER
EXOTEL_ACCOUNT_SID=INJECT_APPROVED_ACCOUNT_SID
EXOTEL_SMS_SENDER_ID=INJECT_APPROVED_SENDER_ID
EXOTEL_DLT_ENTITY_ID=INJECT_APPROVED_DLT_ENTITY_ID
EXOTEL_DLT_TEMPLATE_ID=INJECT_APPROVED_DLT_TEMPLATE_ID
EXOTEL_OTP_BODY_TEMPLATE=INJECT_APPROVED_DLT_TEMPLATE_WITH_EXACTLY_ONE_{{OTP}}_PLACEHOLDER
EXOTEL_REQUEST_TIMEOUT_MS=5000
ALLOWED_ORIGINS=https://erp.example.com
